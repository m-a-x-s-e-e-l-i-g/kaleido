* text=auto eol=lf
*.zip binary
*.mo binary
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary

# Preserve recorded host evidence byte-for-byte.
evidence/** -text
# RST heading underlines are not merge-conflict separators.
*.rst conflict-marker-size=32
# Keep upstream font-license text unchanged.
site/assets/fonts/*-OFL.txt whitespace=-blank-at-eol
